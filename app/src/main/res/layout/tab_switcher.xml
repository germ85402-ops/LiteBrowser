<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_toolbar"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/tsBack"
                style="@style/IconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/c_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/tsMode"
                style="@style/IconButton"
                android:contentDescription="@string/incognito_new"
                android:src="@drawable/ic_incognito" />

            <ImageButton
                android:id="@+id/tsCloseAll"
                style="@style/IconButton"
                android:contentDescription="@string/close_all"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginHorizontal="12dp" android:layout_marginBottom="12dp"
            android:background="@drawable/bg_omnibox" android:gravity="center_vertical">
            <EditText android:id="@+id/tsSearch" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:singleLine="true" android:inputType="text"
                android:imeOptions="actionSearch|flagNoExtractUi" android:hint="@string/tab_search"
                android:textSize="16sp" android:textColor="@color/c_text" android:textColorHint="@color/c_text2"
                android:background="@null" android:paddingHorizontal="16dp" android:importantForAutofill="no" />
            <ImageButton android:id="@+id/tsClear" style="@style/IconButton"
                android:src="@drawable/ic_close_small" android:contentDescription="@string/clear" android:visibility="gone" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/tsEmpty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="32dp" android:text="@string/tabs_no_results"
            android:textColor="@color/c_text2" android:textSize="16sp" android:visibility="gone"
            android:accessibilityLiveRegion="polite" />

        <GridView
            android:id="@+id/tsGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:horizontalSpacing="12dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="2"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="96dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tsNew"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_fab"
        android:drawableStart="@drawable/ic_add_on_accent"
        android:drawablePadding="8dp"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:text="@string/new_tab"
        android:textColor="@color/c_on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</FrameLayout>
