<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/siteHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/c_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/siteSecurity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="@color/c_text2"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_shield_big" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/siteBlocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/c_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="заблокировано на этой странице"
                android:textColor="@color/c_text2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <Switch
        android:id="@+id/siteSwitch"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Блокировать рекламу на сайте"
        android:textColor="@color/c_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/siteSettings"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="Настройки блокировки"
        android:textColor="@color/c_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
